{
  "name": "scannas-york-backend",
  "version": "1.0.0",
  "description": "ScanNasYork Quantamental Stock Screener - Backend API & Workers",
  "main": "api/server.js",
  "scripts": {
    "test": "node --test",
    "start": "node api/server.js",
    "dev": "node --watch api/server.js",
    "worker:technical": "node workers/daily-technical.js",
    "worker:fundamental": "node workers/fundamental.js",
    "fundamental:full": "node workers/fundamental.js --full",
    "update:all": "node workers/update-all.js",
    "db:init": "node db/init.js",
    "db:check": "node scripts/check-db.js",
    "db:check-financials": "node scripts/check-financials.js",
    "test:markets": "node --test test/markets.test.js test/country-economics.test.js test/core-inflation.test.js",
    "db:seed": "node db/seed.js",
    "test:mysql": "node --test test/mysql.integration.test.js",
    "test:on-demand": "node --test test/chart-data.test.js test/stock-snapshot.test.js test/stock-sources.test.js test/sec-data.test.js test/financial-history.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "joi": "^17.13.3",
    "mysql2": "^3.15.3",
    "node-cron": "^3.0.3",
    "sequelize": "^6.37.8",
    "winston": "^3.14.2",
    "yahoo-finance2": "^3.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

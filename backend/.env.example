# ============================================
# ScanNasYork - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scannas_york
DB_USER=root
DB_PASSWORD=Pai123456789

# Optional: FMP earnings calendar (leave empty to disable)
FMP_API_KEY=
# Worker Settings
TECHNICAL_WORKER_CRON=0 17 * * 1-5
FUNDAMENTAL_WORKER_CRON=0 20 * * 1-5
WORKER_BATCH_SIZE=100
WORKER_RETRY_ATTEMPTS=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache TTL (seconds)
CACHE_TTL_QUERY=300
CACHE_TTL_TECHNICAL=3600
